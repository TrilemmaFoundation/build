{
  "name": "build",
  "version": "0.1.0",
  "private": true,
  "description": "Build Trilemma \u2014 open knowledge hub for microproducts (Docusaurus)",
  "scripts": {
    "predev": "node scripts/clear-dev-cache.mjs && node scripts/generate-agent-docs.mjs && node scripts/generate-llms-full.mjs",
    "dev": "docusaurus start",
    "start": "npm run dev",
    "build": "node scripts/generate-agent-docs.mjs && node scripts/generate-llms-full.mjs && docusaurus build && node scripts/validate-build-artifacts.mjs",
    "serve": "docusaurus serve",
    "clear": "docusaurus clear",
    "clean": "docusaurus clear && rm -rf build coverage",
    "prepare": "husky",
    "typecheck": "tsc --noEmit",
    "validate:frontmatter": "node scripts/validate-frontmatter.mjs",
    "validate:registry": "node scripts/validate-registry.mjs",
    "validate:playbook": "node scripts/validate-playbook-tree.mjs",
    "lint:markdown": "markdownlint \"docs/**/*.md\" \"docs/**/*.mdx\" \"README.md\" \"AGENTS.md\" \"CONTRIBUTING.md\" \"CODE_OF_CONDUCT.md\" \"templates/**/*.md\" \"product-templates/**/*.md\" \"products/**/*.md\" --ignore \"docs/agents/human/**\"",
    "spellcheck": "cspell \"docs/**\" \"product-templates/**\" \"templates/**/*.md\"",
    "check:validate": "npm run check:design && npm run typecheck && npm run spellcheck && npm run validate:frontmatter && npm run validate:registry && npm run validate:playbook && npm run lint:markdown",
    "check:fast": "npm run check:validate && npm test",
    "check": "npm run check:fast && npm run build",
    "check:ci": "npm run check:validate && npm run build",
    "test:scripts": "node --test scripts/__tests__/*.test.mjs",
    "test:scripts:coverage": "node --test --experimental-test-coverage --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 --test-coverage-include='scripts/*.mjs' --test-coverage-exclude=scripts/clear-dev-cache.mjs --test-coverage-exclude=scripts/generate-llms-full.mjs scripts/__tests__/*.test.mjs",
    "test": "jest && npm run test:scripts",
    "test:coverage": "jest --coverage && npm run test:scripts:coverage",
    "check:design": "node scripts/check-design-contract.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@docusaurus/core": "^3.10.2",
    "@docusaurus/faster": "^3.10.2",
    "@docusaurus/preset-classic": "^3.10.2",
    "@easyops-cn/docusaurus-search-local": "^0.55.3",
    "@fontsource/roboto": "^5.3.0",
    "@vercel/analytics": "^1.5.0",
    "clsx": "^2.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@docusaurus/module-type-aliases": "^3.10.2",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "babel-jest": "^30.4.1",
    "cspell": "^10.0.1",
    "husky": "^9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "js-yaml": "^5.3.0",
    "markdownlint-cli": "^0.49.1",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "image-size": "npm:image-size-next@2.1.1",
    "serialize-javascript": "^7.0.0",
    "@tootallnate/once": "^3.0.1",
    "sockjs": {
      "uuid": "11.1.1"
    },
    "websocket-driver": "^0.7.5",
    "fast-uri": "3.1.7",
    "browserslist": "4.28.8",
    "qs": "6.16.0",
    "dompurify": "3.4.13",
    "brace-expansion@1": "1.1.18",
    "brace-expansion@2": "2.1.4",
    "brace-expansion@5": "5.0.9",
    "nanoid": "3.3.18",
    "js-yaml@3": "3.15.1",
    "js-yaml@4": "4.3.1",
    "playwright-core": "1.62.1",
    "svgo": "3.3.5",
    "@swc/html": "1.16.2",
    "colord": "2.10.0",
    "joi": "17.13.8",
    "smol-toml": "1.7.2"
  },
  "engines": {
    "node": "22.x"
  }
}
